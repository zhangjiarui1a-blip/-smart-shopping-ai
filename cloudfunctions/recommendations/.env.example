TOKENHUB_API_KEY=replace-with-your-tokenhub-api-key
# TokenHub online inference service ID. hy3 is the supported default model.
TOKENHUB_MODEL=hy3
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
# Keep this below the CloudBase HTTP gateway timeout.
AI_REQUEST_TIMEOUT_MS=25000
ALLOWED_ORIGIN=https://your-cloudbase-domain.example.com
